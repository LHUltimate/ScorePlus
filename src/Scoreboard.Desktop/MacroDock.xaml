<UserControl x:Class="Scoreboard.Desktop.MacroDock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" Foreground="{DynamicResource MacroTextBrush}" Background="#0E1218"
             PreviewMouseMove="MacroDock_PreviewMouseMove"
             PreviewMouseLeftButtonUp="MacroDock_PreviewMouseLeftButtonUp">
  <UserControl.Resources>
    <!-- Dark fallbacks; MacroDock.ApplyTheme replaces these with the selected theme's shades. -->
    <SolidColorBrush x:Key="MacroPanelBrush" Color="#080808"/>
    <SolidColorBrush x:Key="MacroSurfaceBrush" Color="#141414"/>
    <SolidColorBrush x:Key="MacroInputBrush" Color="#050505"/>
    <SolidColorBrush x:Key="MacroTextBrush" Color="#F4F7FB"/>
    <SolidColorBrush x:Key="MacroMutedBrush" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="MacroBorderBrush" Color="#383838"/>
    <SolidColorBrush x:Key="MacroAccentBrush" Color="#38D7A3"/>
    <SolidColorBrush x:Key="MacroAccentSoftBrush" Color="#123C33"/>
    <SolidColorBrush x:Key="MacroAccentTextBrush" Color="#F4F7FB"/>
    <SolidColorBrush x:Key="MacroHoverBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="MacroSelectionBrush" Color="#123C33"/>
    <SolidColorBrush x:Key="MacroSelectionTextBrush" Color="#F4F7FB"/>

    <Style x:Key="MacroAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Background" Value="{DynamicResource MacroSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource MacroBorderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource MacroTextBrush}"/>
    </Style>
    <Style x:Key="MacroAccent" TargetType="Button" BasedOn="{StaticResource MacroAction}">
      <Setter Property="Background" Value="{DynamicResource MacroAccentSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource MacroAccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource MacroAccentTextBrush}"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="MacroBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Background" Value="{DynamicResource MacroInputBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource MacroTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource MacroBorderBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource MacroTextBrush}"/>
    </Style>
    <!-- BasedOn is essential here: without it the explicit style discarded the application's
         ComboBox template and item container style, leaving the native white drop-down behind. -->
    <Style x:Key="MacroCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Background" Value="{DynamicResource MacroInputBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource MacroTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource MacroBorderBrush}"/>
    </Style>
    <Style x:Key="MacroLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource MacroMutedBrush}"/>
      <Setter Property="Margin" Value="0,7,0,3"/>
    </Style>
    <Style x:Key="MacroHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{DynamicResource MacroMutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="MacroListItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource MacroTextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource MacroSurfaceBrush}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                    CornerRadius="4" BorderThickness="0">
              <ContentPresenter VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource MacroHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource MacroSelectionBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource MacroSelectionTextBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <DockPanel>
  <!-- Show: the ordered cue list and its transport, above the palette of macro buttons that the
       cues run. This is the same tab, not a second one. -->
  <Border x:Name="CuePanel" DockPanel.Dock="Top" Background="{DynamicResource MacroSurfaceBrush}" BorderBrush="{DynamicResource MacroBorderBrush}"
          BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,8">
    <StackPanel>
      <DockPanel Margin="0,0,0,6">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="CuePrevButton" Style="{StaticResource MacroAction}" Content="◀ PREV" MinWidth="72"
                  Click="CuePrevious_Click" ToolTip="Move the cue marker back without running anything (Page Up)"/>
          <Button x:Name="CueGoButton" Style="{StaticResource MacroAccent}" Content="GO" MinWidth="92" MinHeight="38"
                  FontSize="15" Click="CueGo_Click" ToolTip="Run the current cue and move to the next armed cue (Space)"/>
          <Button x:Name="CueNextButton" Style="{StaticResource MacroAction}" Content="NEXT ▶" MinWidth="72"
                  Click="CueNext_Click" ToolTip="Move the cue marker forward without running anything (Page Down)"/>
          <Button x:Name="CueSkipButton" Style="{StaticResource MacroAction}" Content="Skip cue"
                  Click="CueSkip_Click" ToolTip="Pass over the current cue and mark the next one"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="3" Height="13" CornerRadius="2" Background="{DynamicResource MacroAccentBrush}" Margin="0,0,7,0"/>
          <TextBlock Text="SHOW" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MacroTextBrush}" VerticalAlignment="Center"/>
          <TextBlock x:Name="CueStatus" Text="No cues yet" FontSize="11" Foreground="{DynamicResource MacroMutedBrush}"
                     VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </DockPanel>
      <Grid x:Name="CueWorkspace" Height="156">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="240"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource MacroInputBrush}" CornerRadius="7" Padding="3">
          <Grid>
            <!-- The list paints its own background: a transparent ListBox fell back to the system
                 white and left the cue area unreadable on the dark operator theme. -->
            <ListBox x:Name="CueList" Background="{DynamicResource MacroInputBrush}" BorderThickness="0"
                     Foreground="{DynamicResource MacroTextBrush}"
                     FontFamily="Consolas" FontSize="11" ItemContainerStyle="{StaticResource MacroListItem}"
                     SelectionChanged="CueList_SelectionChanged" MouseDoubleClick="CueList_DoubleClick">
              <!-- Themed template: the app's ListBox style paints a white scroll area over the cue
                   row, which hid the list on the dark operator theme. -->
              <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                  <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ScrollViewer Focusable="False" Background="Transparent"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <ItemsPresenter/>
                    </ScrollViewer>
                  </Border>
                </ControlTemplate>
              </ListBox.Template>
            </ListBox>
            <TextBlock x:Name="CueEmptyText" Text="No cues yet. Add one from the selected macro below, or start from the palette."
                       Style="{StaticResource MacroHint}" Margin="8,8" Visibility="Visible"/>
          </Grid>
        </Border>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="CUE NAME" Style="{StaticResource MacroLabel}" Margin="0,0,0,2"/>
          <TextBox x:Name="CueNameBox" Style="{StaticResource MacroBox}" TextChanged="CueName_Changed"/>
          <TextBlock Text="NOTES" Style="{StaticResource MacroLabel}"/>
          <TextBox x:Name="CueNotesBox" Style="{StaticResource MacroBox}" Height="32" AcceptsReturn="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="CueNotes_Changed"/>
          <WrapPanel Margin="0,5,0,0">
            <Button x:Name="CueAddButton" Style="{StaticResource MacroAction}" Content="+ Cue" Padding="8,4" Click="CueAdd_Click" ToolTip="Add the selected macro as the next cue"/>
            <Button x:Name="CueRemoveButton" Style="{StaticResource MacroAction}" Content="Remove" Padding="8,4" Click="CueRemove_Click"/>
            <Button x:Name="CueUpButton" Style="{StaticResource MacroAction}" Content="↑" Padding="9,4" Click="CueUp_Click"/>
            <Button x:Name="CueDownButton" Style="{StaticResource MacroAction}" Content="↓" Padding="9,4" Click="CueDown_Click"/>
          </WrapPanel>
          <Button x:Name="CueArmButton" Style="{StaticResource MacroAction}" Content="Arm / disarm" Padding="8,4"
                  Margin="0,0,0,0" HorizontalAlignment="Stretch" Click="CueArm_Click"/>
        </StackPanel>
        </ScrollViewer>
      </Grid>
      <Expander x:Name="PracticeExpander" Header="PRACTICE TIMER" IsExpanded="False" Margin="0,6,0,0"
                Expanded="PracticeExpander_Expanded"
                Foreground="{DynamicResource MacroMutedBrush}" FontSize="10" FontWeight="Bold">
        <StackPanel Margin="0,4,0,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="PracticeStartButton" Style="{StaticResource MacroAction}" Content="Start"
                      Click="PracticeStart_Click" MinWidth="64"/>
              <Button x:Name="PracticeNextButton" Style="{StaticResource MacroAction}" Content="Next segment"
                      Click="PracticeNext_Click"/>
              <Button x:Name="PracticeResetButton" Style="{StaticResource MacroAction}" Content="Reset"
                      Click="PracticeReset_Click"/>
            </StackPanel>
            <TextBlock x:Name="PracticeStatus" Text="No segments" FontSize="11"
                       Foreground="{DynamicResource MacroTextBrush}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <Grid Height="86" Margin="0,5,0,0">
            <ListBox x:Name="PracticeList" Background="{DynamicResource MacroInputBrush}" BorderThickness="0"
                     Foreground="{DynamicResource MacroTextBrush}" FontFamily="Consolas" FontSize="11"
                     ItemContainerStyle="{StaticResource MacroListItem}"
                     SelectionChanged="PracticeList_SelectionChanged" MouseDoubleClick="PracticeList_DoubleClick">
              <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                  <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ScrollViewer Focusable="False" Background="Transparent"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <ItemsPresenter/>
                    </ScrollViewer>
                  </Border>
                </ControlTemplate>
              </ListBox.Template>
            </ListBox>
          </Grid>
          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="72"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="SEGMENT NAME" Style="{StaticResource MacroLabel}" Margin="0,0,0,2"/>
              <TextBox x:Name="PracticeNameBox" Style="{StaticResource MacroBox}"
                       ToolTip="The name shown while this segment runs"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
              <TextBlock Text="MINUTES" Style="{StaticResource MacroLabel}" Margin="0,0,0,2"/>
              <TextBox x:Name="PracticeMinutesBox" Style="{StaticResource MacroBox}"
                       ToolTip="Length in minutes, e.g. 2 or 1.5"/>
            </StackPanel>
          </Grid>
          <WrapPanel Margin="0,4,0,0">
            <Button x:Name="PracticeAddButton" Style="{StaticResource MacroAction}" Content="+ Segment" Click="PracticeAdd_Click"/>
            <Button Style="{StaticResource MacroAction}" Content="Remove" Click="PracticeRemove_Click"/>
          </WrapPanel>
        </StackPanel>
      </Expander>
    </StackPanel>
  </Border>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition x:Name="MacroEditorSplitterColumn" Width="8"/>
      <ColumnDefinition x:Name="MacroEditorColumn" Width="358"/>
    </Grid.ColumnDefinitions>

    <DockPanel Grid.Column="0" Margin="0,0,4,0">
      <StackPanel DockPanel.Dock="Top">
        <DockPanel Margin="0,0,0,4">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <!-- The two controls an operator needs between presses of a macro: publish what the
                 steps staged, and stop or resume the live feed, without leaving this tab. -->
            <Button x:Name="LiveButton" Style="{StaticResource MacroAction}" Content="Live: ON"
                    Click="Live_Click" Margin="0,0,6,0" MinWidth="86"
                    ToolTip="Pause or resume the live score, clock and name feed without leaving the macro board"/>
            <Button x:Name="UpdateOutputButton" Style="{StaticResource MacroAccent}" Content="Update Output"
                    Click="UpdateOutput_Click" Margin="0,0,6,0"
                    ToolTip="Publish every staged value now, the same button the console has"/>
            <Button x:Name="ConditionalsButton" Style="{StaticResource MacroAction}" Content="Macro Conditionals"
                    Click="Conditionals_Click" Margin="0,0,6,0"
                    ToolTip="Macro rules only — run a macro at a time, or when a condition is met. Media and layout rules have their own pages"/>
            <Button x:Name="EditorToggleButton" Style="{StaticResource MacroAction}" Content="Hide editor"
                    Click="ToggleEditor_Click" Margin="0,0,6,0"
                    ToolTip="Hide the step editor so more macro buttons fit on screen"/>
            <Button Style="{StaticResource MacroAccent}" Content="+ New macro"
                    Click="NewMacro_Click"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="3" Height="13" CornerRadius="2" Background="{DynamicResource MacroAccentBrush}" Margin="0,0,7,0"/>
            <TextBlock Text="MACRO PALETTE" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MacroMutedBrush}" VerticalAlignment="Center"/>
          </StackPanel>
        </DockPanel>
        <TextBlock Style="{StaticResource MacroHint}" Text="One button, several changes, in order. Each press runs the full step list against the current game; Update Output then puts the result on air. Drag the handle to any cell or column; empty cells stay open. Media steps start playing immediately."
                   Margin="0,0,0,6"/>
        <DockPanel Margin="0,0,0,7">
          <TextBlock Text="PAGE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MacroMutedBrush}"
                     VerticalAlignment="Center" Margin="0,0,6,0"/>
          <Button x:Name="PrevPageButton" Style="{StaticResource MacroAction}" Content="◀"
                  MinWidth="30" Padding="6,3" Margin="0,0,4,0" Click="PreviousPage_Click"
                  ToolTip="Previous page of macros"/>
          <TextBlock x:Name="PageLabel" Text="PAGE 1 / 1" FontSize="10" FontWeight="Bold"
                     Foreground="{DynamicResource MacroTextBrush}" VerticalAlignment="Center"
                     Margin="2,0,6,0"/>
          <Button x:Name="NextPageButton" Style="{StaticResource MacroAction}" Content="▶"
                  MinWidth="30" Padding="6,3" Margin="0,0,8,0" Click="NextPage_Click"
                  ToolTip="Next page of macros"/>
          <Button x:Name="AddPageButton" Style="{StaticResource MacroAction}" Content="+ Page"
                  Padding="8,3" Margin="0,0,6,0" Click="AddPage_Click"
                  ToolTip="Add a blank page for another board of macros"/>
          <TextBlock Text="PAGE NAME" Style="{StaticResource MacroLabel}" Margin="0,0,5,0"
                     VerticalAlignment="Center"/>
          <TextBox x:Name="PageNameBox" Style="{StaticResource MacroBox}" Width="220" Padding="6,3"
                   LostFocus="PageName_LostFocus" ToolTip="Name this page, e.g. Pre-game or Second half"/>
          <Button x:Name="RemovePageButton" Style="{StaticResource MacroAction}" Content="×"
                  Width="28" MinWidth="28" HorizontalAlignment="Left" Padding="6,3" Margin="6,0,0,0" Click="RemovePage_Click"
                  FontSize="13" ToolTip="Delete this page and the macros on it"/>
        </DockPanel>
      </StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <Grid x:Name="MacroButtons" Margin="0,0,0,8" Background="Transparent"/>
          <TextBlock x:Name="EmptyText" Style="{StaticResource MacroHint}" Margin="2,4,8,0"
                     Text="No macros yet. Choose New macro, add a few steps, then press the macro card to run them together."/>
        </Grid>
      </ScrollViewer>
    </DockPanel>

    <GridSplitter x:Name="MacroEditorSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                  Background="{DynamicResource MacroBorderBrush}" ShowsPreview="True" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

    <Border x:Name="MacroEditor" Grid.Column="2" Background="{DynamicResource MacroPanelBrush}" CornerRadius="9" Padding="12,10">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <DockPanel Margin="0,0,0,9">
            <Border DockPanel.Dock="Right" Margin="14,0,0,0" Padding="8,2" CornerRadius="8"
                    Background="{DynamicResource MacroSurfaceBrush}" BorderBrush="{DynamicResource MacroBorderBrush}" BorderThickness="1">
              <TextBlock x:Name="EditStatus" Text="" FontSize="9" FontWeight="Bold"
                         Foreground="{DynamicResource MacroAccentBrush}" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="EDIT MACRO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MacroMutedBrush}" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock Text="BUTTON LABEL" Style="{StaticResource MacroLabel}" Margin="0,0,0,3"/>
          <TextBox x:Name="NameBox" Style="{StaticResource MacroBox}" TextChanged="Name_Changed"
                   ToolTip="The text on the macro card"/>
          <TextBlock Text="BUTTON COLOR" Style="{StaticResource MacroLabel}" Margin="0,8,0,3"/>
          <DockPanel>
            <Border x:Name="ColorPreview" DockPanel.Dock="Left" Width="32" Height="32"
                    CornerRadius="5" BorderBrush="{DynamicResource MacroBorderBrush}" BorderThickness="1"/>
            <TextBox x:Name="ColorBox" Style="{StaticResource MacroBox}" Margin="7,0,0,0"
                     TextChanged="Color_Changed" LostFocus="Color_LostFocus"
                     ToolTip="A colour code such as #FF6B6B, or choose a swatch below"/>
          </DockPanel>
          <WrapPanel x:Name="ColorChoices" Margin="0,4,0,0"/>
          <TextBlock Style="{StaticResource MacroHint}" Margin="0,2,0,0"
                     Text="Optional colour coding for the macro button. Leave it empty for the theme accent."/>
          <TextBlock Text="TILE SIZE" Style="{StaticResource MacroLabel}" Margin="0,8,0,3"/>
          <ComboBox x:Name="TileSizeBox" Style="{StaticResource MacroCombo}"
                    ToolTip="Resize the tile: a wide tile spans two columns, a tall one two rows">
            <ComboBoxItem Content="1 × 1"/>
            <ComboBoxItem Content="2 × 1 wide"/>
            <ComboBoxItem Content="1 × 2 tall"/>
            <ComboBoxItem Content="2 × 2 large"/>
          </ComboBox>
          <WrapPanel Margin="0,7,0,0">
            <Button x:Name="SaveButton" Style="{StaticResource MacroAccent}" Content="Save macro" Click="Save_Click"/>
            <Button x:Name="DeleteButton" Style="{StaticResource MacroAction}" Content="Delete" Click="Delete_Click"/>
            <Button x:Name="UndoButton" Style="{StaticResource MacroAction}" Content="↶ Undo" Click="Undo_Click"
                    ToolTip="Undo the last macro or step edit (Ctrl+Z)"/>
            <Button x:Name="RedoButton" Style="{StaticResource MacroAction}" Content="↷ Redo" Click="Redo_Click"
                    ToolTip="Redo the macro or step edit Undo took back (Ctrl+Y)"/>
          </WrapPanel>

          <TextBlock Text="STEPS · RUN TOP TO BOTTOM" Style="{StaticResource MacroLabel}"/>
          <ListBox x:Name="StepList" Height="150" Background="{DynamicResource MacroInputBrush}"
                   BorderBrush="{DynamicResource MacroBorderBrush}" Foreground="{DynamicResource MacroTextBrush}"
                   FontSize="11" ItemContainerStyle="{StaticResource MacroListItem}"
                   SelectionChanged="Step_Selected">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel Margin="0,5,0,0">
            <Button Style="{StaticResource MacroAction}" Content="↑ Up" Click="StepUp_Click"/>
            <Button Style="{StaticResource MacroAction}" Content="↓ Down" Click="StepDown_Click"/>
            <Button Style="{StaticResource MacroAction}" Content="Remove step" Click="StepRemove_Click"/>
          </WrapPanel>

          <Border Height="1" Background="{DynamicResource MacroBorderBrush}" Margin="0,10,0,2"/>
          <TextBlock Text="ADD A STEP" Style="{StaticResource MacroLabel}"/>
          <ComboBox x:Name="KindBox" Style="{StaticResource MacroCombo}" SelectionChanged="Kind_Changed"/>

          <StackPanel x:Name="CommandPanel">
            <TextBlock Text="CONSOLE BUTTON" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="CommandBox" Style="{StaticResource MacroCombo}"/>
            <TextBlock Style="{StaticResource MacroHint}" Margin="0,3,0,0"
                       Text="Runs the same action as that button on the console. Set-value dialogs are left out so a macro never stops for a window."/>
          </StackPanel>
          <StackPanel x:Name="SportValuePanel">
            <TextBlock Text="SPORT VALUE" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="SportValueBox" Style="{StaticResource MacroCombo}"/>
            <CheckBox x:Name="SportDeltaBox" Content="Add to the current value instead of replacing it"
                      Foreground="{DynamicResource MacroMutedBrush}" FontSize="10" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel x:Name="CustomValuePanel">
            <TextBlock Text="CUSTOM VALUE" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="CustomValueBox" Style="{StaticResource MacroCombo}"/>
            <CheckBox x:Name="CustomDeltaBox" Content="Add to the current value instead of replacing it"
                      Foreground="{DynamicResource MacroMutedBrush}" FontSize="10" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel x:Name="CopyValuePanel">
            <TextBlock Text="CUSTOM VALUE TO UPDATE" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="CopyTargetBox" Style="{StaticResource MacroCombo}"/>
            <TextBlock Text="VALUE TO COPY" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="CopySourceBox" Style="{StaticResource MacroCombo}"
                      ToolTip="Any live game value: clocks, score, down, records, sport values, custom values or selected-player stats"/>
            <TextBlock Style="{StaticResource MacroHint}" Margin="0,3,0,0"
                       Text="For example, copy the Game Clock into “Last ball snapped” when the snap happens. A custom-value clock also accepts a clock reading."/>
          </StackPanel>
          <StackPanel x:Name="SidePanel">
            <TextBlock Text="SIDE" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="SideBox" Style="{StaticResource MacroCombo}" SelectionChanged="Side_Changed"/>
          </StackPanel>
          <StackPanel x:Name="AmountPanel">
            <TextBlock x:Name="AmountLabel" Text="POINTS TO ADD (CAN BE NEGATIVE)" Style="{StaticResource MacroLabel}"/>
            <TextBox x:Name="AmountBox" Style="{StaticResource MacroBox}" Text="1"/>
          </StackPanel>
          <StackPanel x:Name="ValuePanel">
            <TextBlock x:Name="ValueLabel" Text="VALUE" Style="{StaticResource MacroLabel}"/>
            <TextBox x:Name="ValueBox" Style="{StaticResource MacroBox}" Text="0"/>
          </StackPanel>
          <StackPanel x:Name="WaitPanel">
            <TextBlock Text="WAIT BEFORE THE NEXT STEP (SECONDS)" Style="{StaticResource MacroLabel}"/>
            <TextBox x:Name="WaitSecondsBox" Style="{StaticResource MacroBox}" Text="1"
                     ToolTip="0 to 60 seconds. The macro continues automatically when the wait ends."/>
            <TextBlock Style="{StaticResource MacroHint}" Margin="0,3,0,0"
                       Text="Use a wait to let a replay, graphic or camera settle before the next step."/>
          </StackPanel>
          <StackPanel x:Name="RosterPanel">
            <TextBlock Text="PLAYER" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="PlayerBox" Style="{StaticResource MacroCombo}"
                      ToolTip="On-air player changes whoever is live for that side, even after a substitution. Pick a name to target one player instead."/>
            <TextBlock Text="STAT" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="StatBox" Style="{StaticResource MacroCombo}" IsEditable="True"/>
            <CheckBox x:Name="DeltaBox" Content="Add to the current value instead of replacing it"
                      Foreground="{DynamicResource MacroMutedBrush}" FontSize="10" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel x:Name="VideoPanel">
            <TextBlock Text="MEDIA ITEM" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="MediaBox" Style="{StaticResource MacroCombo}" SelectionChanged="Media_Changed"
                      ToolTip="Clips, cameras, microphones and speaker buses from the media library"/>
            <TextBlock Text="OR A FILE / LIVE SOURCE ADDRESS" Style="{StaticResource MacroLabel}"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="VideoPathBox" Style="{StaticResource MacroBox}" Margin="0,0,5,0"/>
              <Button Grid.Column="1" Style="{StaticResource MacroAction}" Content="Browse…" Margin="0" Click="BrowseVideo_Click"/>
            </Grid>
            <TextBlock Style="{StaticResource MacroHint}" Margin="0,3,0,0"
                       Text="A clip or camera plays; a microphone or speaker bus is put on air. Already-live sources are left alone."/>
          </StackPanel>

          <StackPanel x:Name="FlagPanel">
            <TextBlock Text="FLAG TYPE" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="FlagTypeBox" Style="{StaticResource MacroCombo}"/>
            <CheckBox x:Name="ClearFlagBox" Content="Clear the flag instead of putting it down"
                      Foreground="{DynamicResource MacroMutedBrush}" FontSize="10" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel x:Name="LayoutPanel">
            <TextBlock Text="LAYOUT" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="LayoutBox" Style="{StaticResource MacroCombo}"
                      ToolTip="Every display's layouts; the switch goes on air immediately"/>
            <TextBlock Style="{StaticResource MacroHint}" Margin="0,3,0,0"
                       Text="The chosen layout is put on air as soon as this step runs."/>
          </StackPanel>

          <StackPanel x:Name="ScenePanel">
            <TextBlock Text="STORYBOARD SCENE" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="SceneBox" Style="{StaticResource MacroCombo}"
                      ToolTip="Publishes the scene's layout with that scene's transition and hold timing"/>
            <TextBlock Style="{StaticResource MacroHint}" Margin="0,3,0,0"
                       Text="A cue can take a whole scene, including the transition built for it, without switching layouts one by one."/>
          </StackPanel>
          <StackPanel x:Name="EffectPanel">
            <TextBlock Text="LAYOUT" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="EffectLayoutBox" Style="{StaticResource MacroCombo}" SelectionChanged="EffectLayout_Changed"
                      ToolTip="The layout whose layer is being changed"/>
            <TextBlock Text="LAYER" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="EffectElementBox" Style="{StaticResource MacroCombo}"
                      ToolTip="Every element in the chosen layout"/>
            <TextBlock Text="EFFECT" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="EffectBox" Style="{StaticResource MacroCombo}">
              <ComboBoxItem Content="None — clear the effect"/>
              <ComboBoxItem Content="Blur"/>
              <ComboBoxItem Content="Glow"/>
            </ComboBox>
            <TextBlock Text="STRENGTH · 0–100" Style="{StaticResource MacroLabel}"/>
            <TextBox x:Name="EffectAmountBox" Style="{StaticResource MacroBox}" Text="50"/>
            <TextBlock Text="GLOW COLOUR" Style="{StaticResource MacroLabel}"/>
            <TextBox x:Name="EffectColorBox" Style="{StaticResource MacroBox}" Text="#FF38D7A3"
                     ToolTip="A colour such as #FF38D7A3. Blur ignores it."/>
            <TextBlock Style="{StaticResource MacroHint}" Margin="0,3,0,0"
                       Text="These are the effects WPF actually draws: blur and glow. A cue can set one layer or clear it again."/>
          </StackPanel>
          <StackPanel x:Name="ClockPanel">
            <TextBlock Text="CLOCK" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="ClockBox" Style="{StaticResource MacroCombo}"/>
            <TextBlock Text="ACTION" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="ClockActionBox" Style="{StaticResource MacroCombo}"/>
            <TextBlock Style="{StaticResource MacroHint}" Margin="0,3,0,0"
                       Text="Start and stop check whether the clock is already running, so pressing the macro twice cannot flip it the other way."/>
          </StackPanel>
          <StackPanel x:Name="CustomClockPanel">
            <TextBlock Text="CUSTOM CLOCK" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="CustomClockBox" Style="{StaticResource MacroCombo}"
                      ToolTip="Every custom value on the console that is a clock"/>
            <TextBlock Text="ACTION" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="CustomClockActionBox" Style="{StaticResource MacroCombo}"/>
            <TextBlock Style="{StaticResource MacroHint}" Margin="0,3,0,0"
                       Text="Start and stop check whether the clock is already running, so pressing the macro twice cannot flip it the other way. Reset returns it to the time it was created with."/>
          </StackPanel>
          <StackPanel x:Name="ClockMessagePanel">
            <TextBlock Text="CLOCK READS" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="ClockMessageBox" Style="{StaticResource MacroCombo}"/>
            <TextBlock Style="{StaticResource MacroHint}" Margin="0,3,0,0"
                       Text="The words the audience clock prints instead of a time. The time itself is kept underneath."/>
          </StackPanel>
          <StackPanel x:Name="VolumePanel">
            <TextBlock Text="MEDIA ITEM" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="VolumeMediaBox" Style="{StaticResource MacroCombo}"
                      ToolTip="Clips, cameras, microphones and speaker buses from the media library"/>
            <TextBlock Text="LEVEL ACTION" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="VolumeModeBox" Style="{StaticResource MacroCombo}" SelectionChanged="VolumeMode_Changed"/>
            <StackPanel x:Name="VolumePercentRow">
              <TextBlock Text="LEVEL (%) · 0–100" Style="{StaticResource MacroLabel}"/>
              <TextBox x:Name="VolumePercentBox" Style="{StaticResource MacroBox}" Text="100"/>
            </StackPanel>
            <TextBlock Style="{StaticResource MacroHint}" Margin="0,3,0,0"
                       Text="A level change acts at once and never restarts the picture or the capture. Mute and unmute keep the level the bus already had."/>
          </StackPanel>
          <StackPanel x:Name="TickerPanel">
            <TextBlock Text="TICKER HEADLINES · ONE PER LINE" Style="{StaticResource MacroLabel}"/>
            <TextBox x:Name="TickerTextBox" Style="{StaticResource MacroBox}" AcceptsReturn="True"
                     Height="74" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     ToolTip="Each line is one headline on the news ticker"/>
            <TextBlock Style="{StaticResource MacroHint}" Margin="0,3,0,0"
                       Text="Replaces the news headlines and leaves the ticker's rotation, dwell time and score alerts as they are."/>
          </StackPanel>
          <StackPanel x:Name="RunMacroPanel">
            <TextBlock Text="MACRO TO RUN" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="MacroChoiceBox" Style="{StaticResource MacroCombo}"/>
            <TextBlock Style="{StaticResource MacroHint}" Margin="0,3,0,0"
                       Text="That macro's steps run here, in order, inside this press. A macro that names itself, or a chain of more than eight, is skipped."/>
          </StackPanel>
          <StackPanel x:Name="NotePanel">
            <TextBlock Text="HEADING" Style="{StaticResource MacroLabel}"/>
            <TextBox x:Name="NoteTextBox" Style="{StaticResource MacroBox}"
                     ToolTip="Shown in the step list so a long macro can be read in sections"/>
            <TextBlock Style="{StaticResource MacroHint}" Margin="0,3,0,0"
                       Text="A heading runs nothing: it is a signpost between steps, like “Timeout” or “After the try”."/>
          </StackPanel>
          <StackPanel x:Name="ReplayPanel">
            <TextBlock Text="REPLAY ACTION" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="ReplayActionBox" Style="{StaticResource MacroCombo}" SelectionChanged="ReplayAction_Changed"/>
            <StackPanel x:Name="ReplaySecondsRow">
              <TextBlock Text="SECONDS BACK FROM THE LIVE EDGE" Style="{StaticResource MacroLabel}"/>
              <TextBox x:Name="ReplaySecondsBox" Style="{StaticResource MacroBox}" Text="8"
                       ToolTip="How far back the replay should open. 8 puts the play's start eight seconds behind live."/>
            </StackPanel>
            <StackPanel x:Name="ReplaySpeedRow">
              <TextBlock Text="SPEED · 0.1× TO 2.0×" Style="{StaticResource MacroLabel}"/>
              <TextBox x:Name="ReplaySpeedBox" Style="{StaticResource MacroBox}" Text="1.0"/>
            </StackPanel>
            <TextBlock Style="{StaticResource MacroHint}" Margin="0,3,0,0"
                       Text="Set up opens the replay in the preview; Start Replay sends it to air; Speed changes both. No dragging needed, and the manual buttons still work."/>
          </StackPanel>

          <CheckBox x:Name="BypassOutputBox" Content="Bypass Update Output for this step"
                    Foreground="{DynamicResource MacroMutedBrush}" FontSize="10" Margin="0,9,0,2"
                    ToolTip="When checked, this step publishes immediately. When unchecked, its values wait for Update Output. Media steps always bypass."/>
          <TextBlock Style="{StaticResource MacroHint}" Margin="0,0,0,3"
                     Text="Unchecked steps stay staged until Update Output; media always publishes at once."/>
          <WrapPanel Margin="0,9,0,0">
            <Button x:Name="AddStepButton" Style="{StaticResource MacroAccent}" Content="+ Add step" Click="AddStep_Click" Margin="0,0,6,0"/>
            <Button x:Name="UpdateStepButton" Style="{StaticResource MacroAction}" Content="Update selected" Click="UpdateStep_Click" Margin="0"/>
          </WrapPanel>
          <TextBlock Style="{StaticResource MacroHint}" Margin="0,8,0,0"
                     Text="A macro starts from step 1 every time. Score, down, timeouts, clocks and clock messages, levels and mutes, ticker headlines, period, media, cameras, microphones, speaker buses, layouts, storyboard scenes with their transitions, blur/glow layer effects, roster stats, custom values, console buttons, chained macros and any sport value can be mixed freely; a step that needs a missing player or source is skipped and the rest still run."/>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
  </DockPanel>
</UserControl>
