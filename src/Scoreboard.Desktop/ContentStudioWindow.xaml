<Window x:Class="Scoreboard.Desktop.ContentStudioWindow" Icon="app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScorePlus — Content Studio" Width="1520" Height="950" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterOwner" Background="#0E1218" Foreground="#F4F7FB" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#171C25"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="10"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#93A0B2"/>
      <Setter Property="Margin" Value="2,8,2,5"/>
    </Style>
    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>
    <Style x:Key="FieldBox" TargetType="TextBox">
      <Setter Property="Margin" Value="0,0,0,5"/>
      <Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style x:Key="InspectorLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="#7C8A9C"/>
      <Setter Property="Margin" Value="0,4,0,2"/>
    </Style>
    <Style x:Key="SceneCard" TargetType="Button">
      <Setter Property="Width" Value="168"/>
      <Setter Property="Height" Value="126"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Background" Value="#10151D"/>
      <Setter Property="BorderBrush" Value="#2E3B4A"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="196"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============ TOP BAR ============ -->
    <DockPanel Grid.Row="0" Margin="2,0,2,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="AddToDisplayButton" Style="{StaticResource ToolButton}" Content="ADD TO DISPLAY"
                FontWeight="SemiBold" Click="AddToDisplay_Click" ToolTip="Add the selected template to this show as a real, editable layout"/>
        <Button Style="{StaticResource ToolButton}" Content="New from template…" Click="AddToDisplay_Click"/>
        <Button Style="{StaticResource ToolButton}" Content="Export pack…" Click="ExportPack_Click"
                ToolTip="Bundle this display, its brand, storyboard and assets into one .spk file"/>
        <Button Style="{StaticResource ToolButton}" Content="Import pack…" Click="ImportPack_Click"
                ToolTip="Add a content pack from another machine, with its assets and fonts"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Border Background="#0E1218" CornerRadius="7" Padding="7,4" Margin="0,0,10,0" VerticalAlignment="Center">
          <TextBlock Text="CONTENT" FontSize="12" FontWeight="Bold" Foreground="#38D7A3"/>
        </Border>
        <TextBlock Text="SCOREPLUS · CONTENT STUDIO" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBlock Text="   Templates · brand kit · storyboards · sponsor inventory"
                   Foreground="#93A0B2" VerticalAlignment="Center"/>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="278"/>
        <ColumnDefinition Width="7"/>
        <ColumnDefinition Width="*" MinWidth="420"/>
        <ColumnDefinition Width="7"/>
        <ColumnDefinition Width="338"/>
      </Grid.ColumnDefinitions>

      <!-- ============ LEFT: ASSET TREE ============ -->
      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,0,8">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="2,0,2,6">
              <Border Width="3" Height="12" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,7,0"/>
              <TextBlock Text="SHOW CONTENT" FontSize="11" FontWeight="Bold" Foreground="#93A0B2" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBox x:Name="LibrarySearch" MinHeight="30" Margin="0,0,0,7" TextChanged="LibrarySearch_TextChanged"
                     ToolTip="Search the template catalog by name, sport or slot"/>
            <TextBlock Text="GALLERY" Style="{StaticResource SectionTitle}"/>
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="Templates carry brand roles, so one kit repaints every board."
                     Foreground="#5C6B7E" FontSize="10" TextWrapping="Wrap" Margin="2,7,2,0"/>
          <TreeView x:Name="LibraryTree" Background="#10151D" BorderBrush="#2E3B4A" Foreground="#F4F7FB"
                    SelectedItemChanged="LibraryTree_Selected" MouseDoubleClick="LibraryTree_DoubleClick"/>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                    Background="#1E2630" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

      <!-- ============ CENTRE: PREVIEW ============ -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Publish" Style="{StaticResource ToolButton}" Click="Publish_Click"
                      ToolTip="Put the selected layout on air now"/>
              <Button x:Name="UseStoryboardButton" Content="Use in storyboard" Style="{StaticResource ToolButton}" Click="UseInStoryboard_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="SlotBadge" Background="#2B1F4A" CornerRadius="4" Padding="7,3" Margin="0,0,8,0">
                <TextBlock x:Name="SlotBadgeText" Text="SCOREBUG" FontSize="9" FontWeight="Bold" Foreground="#C8B6FF"/>
              </Border>
              <TextBlock x:Name="PreviewTitle" Text="Classic Scorebug" FontSize="18" FontWeight="Bold"/>
              <TextBlock x:Name="PreviewMeta" Text="   Any sport" Foreground="#93A0B2" VerticalAlignment="Center"/>
            </StackPanel>
          </DockPanel>
          <TextBlock Grid.Row="1" x:Name="PreviewDescription" Text="Centred clock, visitors left, home right."
                     Foreground="#93A0B2" FontSize="11" Margin="0,5,0,7" TextWrapping="Wrap"/>
          <Border Grid.Row="2" Background="#080C11" CornerRadius="7" BorderBrush="#2E3B4A" BorderThickness="1"
                  ClipToBounds="True" MinHeight="260">
            <ContentControl x:Name="PreviewHost" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
          </Border>
          <DockPanel Grid.Row="3" Margin="2,7,2,0">
            <TextBlock DockPanel.Dock="Right" x:Name="PreviewStatus" Text="Mock game data"
                       Foreground="#5C6B7E" FontSize="10" VerticalAlignment="Center"/>
            <TextBlock Text="LIVE SAMPLE · the preview uses the show's current game data, not a static picture."
                       Foreground="#5C6B7E" FontSize="10" TextWrapping="Wrap"/>
          </DockPanel>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3" Width="7" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                    Background="#1E2630" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

      <!-- ============ RIGHT: INSPECTOR ============ -->
      <Border Grid.Column="4" Style="{StaticResource Card}" Margin="0,0,0,8">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="2,0,2,7">
            <Border Width="3" Height="12" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,7,0"/>
            <TextBlock x:Name="InspectorTitle" Text="TEMPLATE" FontSize="11" FontWeight="Bold" Foreground="#93A0B2" VerticalAlignment="Center"/>
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="InspectorHost" Margin="2,0,5,0"/>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ============ BOTTOM: STORYBOARD / TIMELINE ============ -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,8">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="2,0,2,7">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PlayButton" Content="▶ PLAY" Style="{StaticResource ToolButton}" Click="Play_Click" ToolTip="Play the storyboard from the selected scene"/>
            <Button x:Name="StopButton" Content="■ STOP" Style="{StaticResource ToolButton}" Click="Stop_Click"/>
            <CheckBox x:Name="LoopInput" Content="Loop" Foreground="#93A0B2" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"
                      Checked="Loop_Changed" Unchecked="Loop_Changed"/>
            <Button Content="+ SCENE" Style="{StaticResource ToolButton}" Click="AddScene_Click"
                    ToolTip="Add the layout being edited to the storyboard"/>
            <Button Content="‹" Style="{StaticResource ToolButton}" Click="MoveSceneLeft_Click" ToolTip="Move this scene earlier"/>
            <Button Content="›" Style="{StaticResource ToolButton}" Click="MoveSceneRight_Click" ToolTip="Move this scene later"/>
            <Button Content="REMOVE" Style="{StaticResource ToolButton}" Click="RemoveScene_Click"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="3" Height="12" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,7,0"/>
            <TextBlock Text="STORYBOARD" FontSize="11" FontWeight="Bold" Foreground="#93A0B2" VerticalAlignment="Center"/>
            <TextBlock x:Name="StoryboardHint" Text="   Arrange layouts into a sequence; each scene carries its own transition."
                       Foreground="#5C6B7E" FontSize="10" VerticalAlignment="Center"/>
          </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="StoryboardStatus" Text="0 scenes"
                   Foreground="#5C6B7E" FontSize="10" Margin="2,6,2,0"/>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="SceneStrip" Orientation="Horizontal" Margin="2,3,2,0"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Border Grid.Row="3" Background="#171C25" CornerRadius="7" Padding="10,5">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" x:Name="BrandStatus" Text="BRAND · ScorePlus" Foreground="#93A0B2" FontSize="10"/>
        <TextBlock x:Name="ContentStatus" Text="CONTENT READY · choose a template or open the brand kit."
                   Foreground="#93A0B2" FontSize="10" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
