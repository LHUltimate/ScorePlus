<Window x:Class="Scoreboard.Desktop.ShowWindow" Icon="app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScorePlus — Show" Width="1440" Height="850" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="#080A0D" Foreground="#F4F7FB" FontFamily="Segoe UI">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="2,0,2,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="#0C0E11" CornerRadius="5" Padding="9,5" Margin="0,0,6,0">
          <TextBlock x:Name="MacroBadge" Text="0 MACROS" FontSize="10" FontWeight="Bold" Foreground="#93A0B2"/>
        </Border>
        <Border Background="#0C0E11" CornerRadius="5" Padding="9,5">
          <TextBlock x:Name="CueBadge" Text="0 CUES" FontSize="10" FontWeight="Bold" Foreground="#F1C40F"/>
        </Border>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Border Background="#080A0D" CornerRadius="7" Padding="7,4" Margin="0,0,10,0" VerticalAlignment="Center">
          <TextBlock Text="LIVE BOOK" FontSize="11" FontWeight="Bold" Foreground="#F1C40F"/>
        </Border>
        <TextBlock Text="SHOW" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBlock Text="   compact macro page, shared with the console" Foreground="#93A0B2" VerticalAlignment="Center"/>
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" Background="#14161A" BorderBrush="#2A2D33" BorderThickness="1"
            CornerRadius="7" Padding="9,6" Margin="0,0,0,9">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="OUTPUTS" FontSize="9" FontWeight="Bold"
                   Foreground="#5C6B7E" VerticalAlignment="Center" Margin="8,0,0,0"/>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ShowDisplayStrip" Orientation="Horizontal"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Border Grid.Row="2" Background="#14161A" BorderBrush="#2A2D33" BorderThickness="1" CornerRadius="7">
      <ContentControl x:Name="ShowHost"/>
    </Border>

    <DockPanel Grid.Row="3" Margin="2,8,2,0">
      <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Text="SHOW READY" Foreground="#93A0B2" FontSize="10"/>
      <TextBlock DockPanel.Dock="Right" Text="Click a macro to run it · F2 edits · cue arrows move the show"
                 Foreground="#5C6B7E" FontSize="10" HorizontalAlignment="Right"/>
    </DockPanel>
  </Grid>
</Window>
