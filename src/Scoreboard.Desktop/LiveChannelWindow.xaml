<Window x:Class="Scoreboard.Desktop.LiveChannelWindow" Icon="app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScorePlus — Live Channel" Width="1420" Height="900" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterOwner" Background="#0E1218" Foreground="#F4F7FB" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#171C25"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="9"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#93A0B2"/>
    </Style>
    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="122"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="2,0,2,9">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Update Output" Style="{StaticResource ToolButton}" Click="UpdateOutput_Click"/>
        <Button Content="Open Display Studio…" Style="{StaticResource ToolButton}" Click="OpenStudio_Click"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Border Background="#0E1218" CornerRadius="7" Padding="7,4" Margin="0,0,10,0" VerticalAlignment="Center">
          <TextBlock Text="CHANNEL" FontSize="10" FontWeight="Bold" Foreground="#7FD1FF"/>
        </Border>
        <TextBlock Text="SCOREPLUS · LIVE CHANNEL" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBlock Text="   Output health · program monitor · event feed · graphics actions"
                   Foreground="#93A0B2" VerticalAlignment="Center"/>
      </StackPanel>
    </DockPanel>

    <!-- ============ OUTPUT STRIP ============ -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,8">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="1,0,1,5">
          <TextBlock DockPanel.Dock="Right" Text="click a display to monitor it"
                     Foreground="#5C6B7E" FontSize="9" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal">
            <Border Width="3" Height="12" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,7,0"/>
            <TextBlock Text="OUTPUTS" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
          </StackPanel>
        </DockPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="OutputStrip" Orientation="Horizontal"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="290"/>
      </Grid.ColumnDefinitions>

      <!-- event feed -->
      <Border Grid.Column="0" Style="{StaticResource Card}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="1,0,1,6">
            <TextBlock x:Name="EventCountText" DockPanel.Dock="Right" Text="0" Foreground="#5C6B7E" FontSize="10" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
              <Border Width="3" Height="12" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,7,0"/>
              <TextBlock Text="EVENT FEED" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
            </StackPanel>
          </DockPanel>
          <ListBox x:Name="EventList" Background="#10151D" BorderBrush="#2E3B4A" Foreground="#DCE5F0" FontSize="10"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,2,0,4">
                  <TextBlock Text="{Binding Time}" Foreground="#5C6B7E" FontSize="9"/>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="10"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- program monitor -->
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="1,0,1,6">
            <Border DockPanel.Dock="Right" Background="#3A1717" CornerRadius="4" Padding="8,3">
              <TextBlock Text="● ON AIR" FontSize="9" FontWeight="Bold" Foreground="#FF9B9B"/>
            </Border>
            <StackPanel Orientation="Horizontal">
              <Border Width="3" Height="12" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,7,0"/>
              <TextBlock x:Name="ChannelName" Text="PROGRAM" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
            </StackPanel>
          </DockPanel>
          <Border Background="#070B10" CornerRadius="6" BorderBrush="#2E3B4A" BorderThickness="1" ClipToBounds="True" MinHeight="280">
            <ContentControl x:Name="ChannelHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
          </Border>
          <DockPanel DockPanel.Dock="Bottom" Margin="1,7,1,0">
            <TextBlock x:Name="NowPlayingText" Text="No layout on air" Foreground="#93A0B2" FontSize="10" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="DataStatus" DockPanel.Dock="Right" Text="DATA · live" Foreground="#38D7A3" FontSize="10"/>
          </DockPanel>
        </DockPanel>
      </Border>

      <!-- action tiles -->
      <Border Grid.Column="4" Style="{StaticResource Card}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="1,0,1,6">
            <TextBlock x:Name="ActionCount" DockPanel.Dock="Right" Text="0" Foreground="#5C6B7E" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <StackPanel Orientation="Horizontal">
              <Border Width="3" Height="12" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,7,0"/>
              <TextBlock Text="GRAPHICS ACTIONS" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
            </StackPanel>
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ActionPanel"/>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="#171C25" CornerRadius="7" Padding="10,5">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" x:Name="ClockStatus" Text="—" Foreground="#93A0B2" FontSize="10" FontFamily="Consolas"/>
        <TextBlock x:Name="StatusText" Text="LIVE CHANNEL READY · output, programme and events in one place."
                   Foreground="#93A0B2" FontSize="10" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
