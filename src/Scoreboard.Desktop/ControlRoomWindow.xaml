<Window x:Class="Scoreboard.Desktop.ControlRoomWindow" Icon="app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScorePlus — Show Control Map" Width="1260" Height="790" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterOwner" Background="#080A0D" Foreground="#F4F7FB" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="HubCard" TargetType="Button">
      <Setter Property="Background" Value="#14161A"/>
      <Setter Property="BorderBrush" Value="#2A2D33"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="HubTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="2,0,2,14">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="#0C0E11" CornerRadius="5" Padding="9,5" Margin="0,0,6,0">
          <TextBlock x:Name="EventBadge" Text="0 EVENTS" FontSize="10" FontWeight="Bold" Foreground="#93A0B2"/>
        </Border>
        <Border Background="#0C0E11" CornerRadius="5" Padding="9,5">
          <TextBlock x:Name="OnAirBadge" Text="0 ON AIR" FontSize="10" FontWeight="Bold" Foreground="#FF9B9B"/>
        </Border>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Border Background="#080A0D" CornerRadius="7" Padding="7,4" Margin="0,0,10,0" VerticalAlignment="Center">
          <TextBlock Text="MAP" FontSize="12" FontWeight="Bold" Foreground="#38D7A3"/>
        </Border>
        <TextBlock Text="SCOREPLUS · SHOW CONTROL MAP" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBlock Text="   one show, four surfaces" Foreground="#93A0B2" VerticalAlignment="Center"/>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="12"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- The signal flow is the same order the show runs in. -->
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="34"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="34"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="34"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" x:Name="DisplayStudioCard" Style="{StaticResource HubCard}" Click="DisplayStudio_Click">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="5"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="#38D7A3" CornerRadius="8,8,0,0"/>
            <StackPanel Grid.Row="1" Margin="16,13,16,13">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="01" FontSize="10" Foreground="#5C6B7E"/>
                <TextBlock Text="DISPLAY STUDIO" Style="{StaticResource HubTitle}"/>
              </DockPanel>
              <TextBlock Text="Design every display" Foreground="#8DEBCB" FontSize="11" Margin="0,2,0,9"/>
              <TextBlock Text="Layers, bindings, logic, animated values, zones and layout previews."
                         Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap"/>
              <Border Background="#0C0E11" CornerRadius="5" Padding="8,5" Margin="0,12,0,0">
                <TextBlock x:Name="DisplayStatus" Text="—" Foreground="#B7C3D2" FontSize="10"/>
              </Border>
            </StackPanel>
          </Grid>
        </Button>
        <TextBlock Grid.Column="1" Text="→" FontSize="20" Foreground="#5C6B7E" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Button Grid.Column="2" x:Name="ContentStudioCard" Style="{StaticResource HubCard}" Click="ContentStudio_Click">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="5"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="#8A6BC8" CornerRadius="8,8,0,0"/>
            <StackPanel Grid.Row="1" Margin="16,13,16,13">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="02" FontSize="10" Foreground="#5C6B7E"/>
                <TextBlock Text="CONTENT STUDIO" Style="{StaticResource HubTitle}"/>
              </DockPanel>
              <TextBlock Text="Brand, templates and stories" Foreground="#D9C9FF" FontSize="11" Margin="0,2,0,9"/>
              <TextBlock Text="Template gallery, brand kit, storyboards, sponsor slots and portable packs."
                         Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap"/>
              <Border Background="#0C0E11" CornerRadius="5" Padding="8,5" Margin="0,12,0,0">
                <TextBlock x:Name="ContentStatus" Text="—" Foreground="#B7C3D2" FontSize="10"/>
              </Border>
            </StackPanel>
          </Grid>
        </Button>
        <TextBlock Grid.Column="3" Text="→" FontSize="20" Foreground="#5C6B7E" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Button Grid.Column="4" x:Name="LiveSwitchCard" Style="{StaticResource HubCard}" Click="LiveSwitch_Click">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="5"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="#E63B3B" CornerRadius="8,8,0,0"/>
            <StackPanel Grid.Row="1" Margin="16,13,16,13">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="03" FontSize="10" Foreground="#5C6B7E"/>
                <TextBlock Text="LIVE SWITCH" Style="{StaticResource HubTitle}"/>
              </DockPanel>
              <TextBlock Text="Take layouts to air" Foreground="#FF9B9B" FontSize="11" Margin="0,2,0,9"/>
              <TextBlock Text="Multiview, program and preview, source rows and layer visibility."
                         Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap"/>
              <Border Background="#0C0E11" CornerRadius="5" Padding="8,5" Margin="0,12,0,0">
                <TextBlock x:Name="SwitchStatus" Text="—" Foreground="#B7C3D2" FontSize="10"/>
              </Border>
            </StackPanel>
          </Grid>
        </Button>
        <TextBlock Grid.Column="5" Text="→" FontSize="20" Foreground="#5C6B7E" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Button Grid.Column="6" x:Name="LiveChannelCard" Style="{StaticResource HubCard}" Click="LiveChannel_Click">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="5"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="#3D8FB8" CornerRadius="8,8,0,0"/>
            <StackPanel Grid.Row="1" Margin="16,13,16,13">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="04" FontSize="10" Foreground="#5C6B7E"/>
                <TextBlock Text="LIVE CHANNEL" Style="{StaticResource HubTitle}"/>
              </DockPanel>
              <TextBlock Text="Monitor and fire graphics" Foreground="#BFE7FA" FontSize="11" Margin="0,2,0,9"/>
              <TextBlock Text="Output health, the on-air monitor, event feed and one-press graphics actions."
                         Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap"/>
              <Border Background="#0C0E11" CornerRadius="5" Padding="8,5" Margin="0,12,0,0">
                <TextBlock x:Name="ChannelStatus" Text="—" Foreground="#B7C3D2" FontSize="10"/>
              </Border>
            </StackPanel>
          </Grid>
        </Button>
      </Grid>

      <!-- The room's live state, without a second dashboard. -->
      <Border Grid.Row="2" Background="#14161A" CornerRadius="9" Padding="14,11">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="PROGRAM" Foreground="#5C6B7E" FontSize="9" FontWeight="Bold"/>
            <TextBlock x:Name="ProgramName" Text="—" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
            <TextBlock x:Name="ProgramState" Text="—" Foreground="#93A0B2" FontSize="10"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="DISPLAYS" Foreground="#5C6B7E" FontSize="9" FontWeight="Bold"/>
            <TextBlock x:Name="DisplayCount" Text="—" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
            <TextBlock x:Name="DisplayNames" Text="—" Foreground="#93A0B2" FontSize="10" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="CONTENT" Foreground="#5C6B7E" FontSize="9" FontWeight="Bold"/>
            <TextBlock x:Name="ContentCount" Text="—" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
            <TextBlock x:Name="ContentNames" Text="—" Foreground="#93A0B2" FontSize="10" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Grid.Column="3">
            <TextBlock Text="SPINE" Foreground="#5C6B7E" FontSize="9" FontWeight="Bold"/>
            <TextBlock x:Name="SpineCount" Text="—" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
            <TextBlock x:Name="SpineState" Text="—" Foreground="#93A0B2" FontSize="10"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#14161A" CornerRadius="7" Padding="10,5" Margin="0,10,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="Each surface is its own window; the show file is shared."
                 Foreground="#5C6B7E" FontSize="10"/>
        <TextBlock x:Name="StatusText" Text="SHOW CONTROL MAP READY" Foreground="#93A0B2" FontSize="10"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
