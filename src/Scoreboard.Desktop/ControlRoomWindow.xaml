<Window x:Class="Scoreboard.Desktop.ControlRoomWindow" Icon="app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScorePlus — Control Room" Width="1320" Height="850" MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="#080A0D" Foreground="#F4F7FB" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="HubCard" TargetType="Button">
      <Setter Property="Background" Value="#14161A"/>
      <Setter Property="BorderBrush" Value="#2A2D33"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="HubTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="2,0,2,14">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="#0C0E11" CornerRadius="5" Padding="9,5" Margin="0,0,6,0">
          <TextBlock x:Name="EventBadge" Text="0 EVENTS" FontSize="10" FontWeight="Bold" Foreground="#93A0B2"/>
        </Border>
        <Border Background="#0C0E11" CornerRadius="5" Padding="9,5">
          <TextBlock x:Name="OnAirBadge" Text="0 ON AIR" FontSize="10" FontWeight="Bold" Foreground="#FF9B9B"/>
        </Border>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Border Background="#080A0D" CornerRadius="7" Padding="7,4" Margin="0,0,10,0" VerticalAlignment="Center">
          <TextBlock Text="ROOM" FontSize="11" FontWeight="Bold" Foreground="#38D7A3"/>
        </Border>
        <TextBlock Text="SCOREPLUS · CONTROL ROOM" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBlock Text="   every surface, one shared show" Foreground="#93A0B2" VerticalAlignment="Center"/>
      </StackPanel>
    </DockPanel>

    <UniformGrid Grid.Row="1" Columns="4" Rows="3" VerticalAlignment="Center">
      <Button x:Name="DisplayStudioCard" Style="{StaticResource HubCard}" Click="DisplayStudio_Click" Margin="0,0,8,8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Background="#38D7A3" CornerRadius="8,8,0,0"/>
          <StackPanel Grid.Row="1" Margin="15,12,15,12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="01" FontSize="10" Foreground="#5C6B7E"/>
              <TextBlock Text="DISPLAY STUDIO" Style="{StaticResource HubTitle}"/>
            </DockPanel>
            <TextBlock Text="Design every display" Foreground="#8DEBCB" FontSize="11" Margin="0,2,0,8"/>
            <TextBlock Text="Layers, bindings, logic, animated values and layout previews."
                       Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap"/>
            <Border Background="#0C0E11" CornerRadius="5" Padding="8,5" Margin="0,10,0,0">
              <TextBlock x:Name="DisplayStatus" Text="—" Foreground="#B7C3D2" FontSize="10"/>
            </Border>
          </StackPanel>
        </Grid>
      </Button>

      <Button x:Name="ContentStudioCard" Style="{StaticResource HubCard}" Click="ContentStudio_Click" Margin="0,0,8,8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Background="#8A6BC8" CornerRadius="8,8,0,0"/>
          <StackPanel Grid.Row="1" Margin="15,12,15,12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="02" FontSize="10" Foreground="#5C6B7E"/>
              <TextBlock Text="CONTENT STUDIO" Style="{StaticResource HubTitle}"/>
            </DockPanel>
            <TextBlock Text="Templates, brand and storyboards" Foreground="#D9C9FF" FontSize="11" Margin="0,2,0,8"/>
            <TextBlock Text="A storyboard is an ordered sequence of layout scenes with transitions between them."
                       Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap"/>
            <Border Background="#0C0E11" CornerRadius="5" Padding="8,5" Margin="0,10,0,0">
              <TextBlock x:Name="ContentStatus" Text="—" Foreground="#B7C3D2" FontSize="10"/>
            </Border>
          </StackPanel>
        </Grid>
      </Button>

      <Button x:Name="ShowCard" Style="{StaticResource HubCard}" Click="Show_Click" Margin="0,0,8,8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Background="#F1C40F" CornerRadius="8,8,0,0"/>
          <StackPanel Grid.Row="1" Margin="15,12,15,12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="03" FontSize="10" Foreground="#5C6B7E"/>
              <TextBlock Text="SHOW" Style="{StaticResource HubTitle}"/>
            </DockPanel>
            <TextBlock Text="Live Book macro page" Foreground="#FFE58A" FontSize="11" Margin="0,2,0,8"/>
            <TextBlock Text="The cue list and compact macro grid for running the show, with the step editor one click away."
                       Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap"/>
            <Border Background="#0C0E11" CornerRadius="5" Padding="8,5" Margin="0,10,0,0">
              <TextBlock x:Name="ShowStatus" Text="—" Foreground="#B7C3D2" FontSize="10"/>
            </Border>
          </StackPanel>
        </Grid>
      </Button>

      <Button x:Name="LiveSwitchCard" Style="{StaticResource HubCard}" Click="LiveSwitch_Click" Margin="0,0,0,8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Background="#E63B3B" CornerRadius="8,8,0,0"/>
          <StackPanel Grid.Row="1" Margin="15,12,15,12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="04" FontSize="10" Foreground="#5C6B7E"/>
              <TextBlock Text="LIVE SWITCH" Style="{StaticResource HubTitle}"/>
            </DockPanel>
            <TextBlock Text="Take layouts to air" Foreground="#FF9B9B" FontSize="11" Margin="0,2,0,8"/>
            <TextBlock Text="Multiview, program and preview, source rows and layer visibility."
                       Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap"/>
            <Border Background="#0C0E11" CornerRadius="5" Padding="8,5" Margin="0,10,0,0">
              <TextBlock x:Name="SwitchStatus" Text="—" Foreground="#B7C3D2" FontSize="10"/>
            </Border>
          </StackPanel>
        </Grid>
      </Button>

      <Button x:Name="LiveClipsCard" Style="{StaticResource HubCard}" Click="LiveClips_Click" Margin="0,0,8,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Background="#F1A33C" CornerRadius="8,8,0,0"/>
          <StackPanel Grid.Row="1" Margin="15,12,15,12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="05" FontSize="10" Foreground="#5C6B7E"/>
              <TextBlock Text="LIVE CLIPS" Style="{StaticResource HubTitle}"/>
            </DockPanel>
            <TextBlock Text="Two fills from thumbnails" Foreground="#FFD8A3" FontSize="11" Margin="0,2,0,8"/>
            <TextBlock Text="Clip and camera launcher with fill A and B, independent transport and takes."
                       Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap"/>
            <Border Background="#0C0E11" CornerRadius="5" Padding="8,5" Margin="0,10,0,0">
              <TextBlock x:Name="ClipsStatus" Text="—" Foreground="#B7C3D2" FontSize="10"/>
            </Border>
          </StackPanel>
        </Grid>
      </Button>

      <Button x:Name="LiveChannelCard" Style="{StaticResource HubCard}" Click="LiveChannel_Click" Margin="0,0,8,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Background="#3D8FB8" CornerRadius="8,8,0,0"/>
          <StackPanel Grid.Row="1" Margin="15,12,15,12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="06" FontSize="10" Foreground="#5C6B7E"/>
              <TextBlock Text="LIVE CHANNEL" Style="{StaticResource HubTitle}"/>
            </DockPanel>
            <TextBlock Text="Monitor and stream graphics" Foreground="#BFE7FA" FontSize="11" Margin="0,2,0,8"/>
            <TextBlock Text="Output health, the on-air monitor, event feed and camera-backed channel streams."
                       Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap"/>
            <Border Background="#0C0E11" CornerRadius="5" Padding="8,5" Margin="0,10,0,0">
              <TextBlock x:Name="ChannelStatus" Text="—" Foreground="#B7C3D2" FontSize="10"/>
            </Border>
          </StackPanel>
        </Grid>
      </Button>

      <Button x:Name="ReplayBoothCard" Style="{StaticResource HubCard}" Click="ReplayBooth_Click" Margin="0,0,8,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Background="#B98CFF" CornerRadius="8,8,0,0"/>
          <StackPanel Grid.Row="1" Margin="15,12,15,12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="07" FontSize="10" Foreground="#5C6B7E"/>
              <TextBlock Text="REPLAY BOOTH" Style="{StaticResource HubTitle}"/>
            </DockPanel>
            <TextBlock Text="Mark, rate and save" Foreground="#D9C9FF" FontSize="11" Margin="0,2,0,8"/>
            <TextBlock Text="Every camera with its recorded clocks, mark in/out, rating and game tags."
                       Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap"/>
            <Border Background="#0C0E11" CornerRadius="5" Padding="8,5" Margin="0,10,0,0">
              <TextBlock x:Name="ReplayStatus" Text="—" Foreground="#B7C3D2" FontSize="10"/>
            </Border>
          </StackPanel>
        </Grid>
      </Button>

      <Button x:Name="VenueCard" Style="{StaticResource HubCard}" Click="Venue_Click" Margin="0,0,8,8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Background="#2ECC71" CornerRadius="8,8,0,0"/>
          <StackPanel Grid.Row="1" Margin="15,12,15,12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="08" FontSize="10" Foreground="#5C6B7E"/>
              <TextBlock Text="VENUE" Style="{StaticResource HubTitle}"/>
            </DockPanel>
            <TextBlock Text="Displays and scheduled content" Foreground="#8EF0B5" FontSize="11" Margin="0,2,0,8"/>
            <TextBlock Text="Fleet, playlists, schedules, sponsors, proof of play and concourse channels."
                       Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap"/>
            <Border Background="#0C0E11" CornerRadius="5" Padding="8,5" Margin="0,10,0,0">
              <TextBlock x:Name="VenueStatus" Text="—" Foreground="#B7C3D2" FontSize="10"/>
            </Border>
          </StackPanel>
        </Grid>
      </Button>

      <Button x:Name="GraphicsCard" Style="{StaticResource HubCard}" Click="GraphicsOutput_Click" Margin="0,0,8,8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Background="#D66BD8" CornerRadius="8,8,0,0"/>
          <StackPanel Grid.Row="1" Margin="15,12,15,12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="09" FontSize="10" Foreground="#5C6B7E"/>
              <TextBlock Text="GRAPHICS OUTPUT" Style="{StaticResource HubTitle}"/>
            </DockPanel>
            <TextBlock Text="Fill + key for the router" Foreground="#F1C2F2" FontSize="11" Margin="0,2,0,8"/>
            <TextBlock Text="Separate fill and key pictures, key colour, scorebug stack and local URLs."
                       Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap"/>
            <Border Background="#0C0E11" CornerRadius="5" Padding="8,5" Margin="0,10,0,0">
              <TextBlock x:Name="GraphicsStatus" Text="—" Foreground="#B7C3D2" FontSize="10"/>
            </Border>
          </StackPanel>
        </Grid>
      </Button>

      <Button x:Name="StreamStudioCard" Style="{StaticResource HubCard}" Click="LiveBook_Click" Margin="0,0,8,8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Background="#38D7A3" CornerRadius="8,8,0,0"/>
          <StackPanel Grid.Row="1" Margin="15,12,15,12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="10" FontSize="10" Foreground="#5C6B7E"/>
              <TextBlock Text="STREAM STUDIO" Style="{StaticResource HubTitle}"/>
            </DockPanel>
            <TextBlock Text="Channels, displays and providers" Foreground="#8DEBCB" FontSize="11" Margin="0,2,0,8"/>
            <TextBlock Text="Compose the programme, assign a display or venue channel, and push to a 3rd-party RTMP provider."
                       Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap"/>
            <Border Background="#0C0E11" CornerRadius="5" Padding="8,5" Margin="0,10,0,0">
              <TextBlock x:Name="StudioStatus" Text="—" Foreground="#B7C3D2" FontSize="10"/>
            </Border>
          </StackPanel>
        </Grid>
      </Button>

      <Button x:Name="CameraSwitchCard" Style="{StaticResource HubCard}" Click="CameraSwitch_Click" Margin="0,0,8,8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Background="#E9863B" CornerRadius="8,8,0,0"/>
          <StackPanel Grid.Row="1" Margin="15,12,15,12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="11" FontSize="10" Foreground="#5C6B7E"/>
              <TextBlock Text="CAMERA SWITCH" Style="{StaticResource HubTitle}"/>
            </DockPanel>
            <TextBlock Text="Cameras only, Fill A / Fill B" Foreground="#FFD0A3" FontSize="11" Margin="0,2,0,8"/>
            <TextBlock Text="Camera wall with the fill each camera is assigned to, plus take and return to live."
                       Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap"/>
            <Border Background="#0C0E11" CornerRadius="5" Padding="8,5" Margin="0,10,0,0">
              <TextBlock x:Name="CameraSwitchStatus" Text="—" Foreground="#B7C3D2" FontSize="10"/>
            </Border>
          </StackPanel>
        </Grid>
      </Button>

      <Button x:Name="MultiviewCard" Style="{StaticResource HubCard}" Click="Multiview_Click" Margin="0,0,0,8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Background="#4C9AFF" CornerRadius="8,8,0,0"/>
          <StackPanel Grid.Row="1" Margin="15,12,15,12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="12" FontSize="10" Foreground="#5C6B7E"/>
              <TextBlock Text="MULTIVIEW" Style="{StaticResource HubTitle}"/>
            </DockPanel>
            <TextBlock Text="Every source on one wall" Foreground="#BFD9FF" FontSize="11" Margin="0,2,0,8"/>
            <TextBlock Text="Per-tile previews, audience displays, cameras and replay, with tally borders and sound bars."
                       Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap"/>
            <Border Background="#0C0E11" CornerRadius="5" Padding="8,5" Margin="0,10,0,0">
              <TextBlock x:Name="MultiviewStatus" Text="—" Foreground="#B7C3D2" FontSize="10"/>
            </Border>
          </StackPanel>
        </Grid>
      </Button>
    </UniformGrid>

    <Border Grid.Row="2" Background="#14161A" CornerRadius="7" Padding="11,6" Margin="0,12,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="Each surface opens in its own window; the show file is shared."
                   Foreground="#5C6B7E" FontSize="10"/>
        <TextBlock x:Name="StatusText" Text="CONTROL ROOM READY" Foreground="#93A0B2" FontSize="10"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
